# Supabase - Flegon Membros
# Substitua com as credenciais do seu projeto Supabase isolado para o Flegon
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave administrativa (Service Role) - Necessária para ações administrativas do servidor (criação/gestão de usuários)
# ATENÇÃO: NUNCA exponha esta chave no front-end ou em repositórios públicos.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada
